APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=regulated-ai-control-plane

# Execution is network-silent by default.
REGULAAI_EXECUTION_MODE=mock

# Optional organization-managed signed policy/provider release. Set both paths together in
# deployment; private signing keys never belong in the service environment.
# REGULAAI_CONTROL_PACK_MANIFEST=/etc/regulaai/control-pack-manifest.yaml
# REGULAAI_CONTROL_PACK_TRUST_STORE=/etc/regulaai/control-pack-signing-keys.yaml

# Optional verification-only approval adapter. Issuance remains in an external organization-owned
# workflow. Use a dedicated secret of at least 32 bytes; do not commit it.
# REGULAAI_APPROVAL_HMAC_KEY=
# REGULAAI_APPROVAL_MAX_LIFETIME_SECONDS=3600

# Optional action-specific verifier. Use a key distinct from decision approval so ra1 authority
# cannot be reused for ra2 tool actions. Phase 4c tool execution remains network-silent.
# REGULAAI_ACTION_APPROVAL_HMAC_KEY=
# REGULAAI_ACTION_APPROVAL_MAX_LIFETIME_SECONDS=3600

# Required only when REGULAAI_EXECUTION_MODE=gateway. Keep credentials out of files and VCS.
# GOVERNED_LLM_GATEWAY_URL=https://gateway.example.internal
# GOVERNED_LLM_GATEWAY_API_KEY=
# REGULAAI_GATEWAY_WORKLOAD=regulated-ai.external-inference
# REGULAAI_GATEWAY_ALLOWED_TARGET=openai.responses_api.global
# REGULAAI_GATEWAY_EXPECTED_PROVIDER=openai
# REGULAAI_GATEWAY_REQUEST_TIMEOUT_SECONDS=60
# REGULAAI_GATEWAY_PROVIDER_TIMEOUT_SECONDS=30
# REGULAAI_GATEWAY_MAX_OUTPUT_TOKENS=2000
# REGULAAI_GATEWAY_MAX_INPUT_BYTES=1048576

# Optional vendor-neutral OpenTelemetry traces (see docs/LLM_OBSERVABILITY.md).
# Network-silent unless an endpoint is explicitly set. Requires `uv sync --extra observability`.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=regulated-ai-control-plane
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=0.1.0

# Optional Langfuse tracing (opt-in; see docs/LLM_OBSERVABILITY.md).
# Leave unset to keep tracing disabled. Requires `uv sync --extra tracing`.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
